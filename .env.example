# Environment: development or production
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# API key from https://www.football-data.org/
API_KEY=

# Frontend URL(s) allowed by CORS, comma-separated, e.g. https://your-frontend.com,https://www.your-frontend.com
# (in development, http://localhost and http://127.0.0.1 are always allowed)
FRONT_END_ORIGIN=

# Google Gemini API key, used by /api/v1/predict-scores (required to start the server)
GEMINI_API_KEY=

# OpenAI API key, used by /api/v2/predict-scores (required to start the server)
OPENAI_API_KEY=

# Redis connection URL, e.g. redis://localhost:6379 (server works without Redis, but cache is not persisted)
REDIS_URL=redis://localhost:6379

# Sentry DSN for error tracking (optional, leave empty to disable)
SENTRY_DSN=

# VERCEL is set automatically on Vercel, don't set it manually
